        "textJa": "ネットワークの基礎（IP アドレス、CIDR 表記、サブネット、ルーティング、インターネットゲートウェイ）"
      },
      {
        "id": "basics-K5",
        "kind": "knowledge",
        "textJa": "DNS・HTTP と HTTPS・TLS・ポート番号の基礎"
      },
      {
        "id": "basics-K6",
        "kind": "knowledge",
        "textJa": "認証と認可、IAM の基本（ユーザー、グループ、ロール、ポリシー）"
      },
      {
        "id": "basics-K7",
        "kind": "knowledge",
        "textJa": "暗号化の基礎（保存時と転送時、鍵の管理）"
      },
      {
        "id": "basics-K8",
        "kind": "knowledge",
        "textJa": "ストレージの種類（ブロック、ファイル、オブジェクト）と代表的なサービス"
      },
      {
        "id": "basics-K9",
        "kind": "knowledge",
        "textJa": "データベースの種類（リレーショナル、キーバリュー、インメモリ、データウェアハウス）"
      },
      {
        "id": "basics-K10",
        "kind": "knowledge",
        "textJa": "可用性・耐障害性・スケーラビリティの基礎（冗長化、水平と垂直のスケーリング、RPO と RTO）"
      },
      {
        "id": "basics-K11",
        "kind": "knowledge",
        "textJa": "疎結合・イベント駆動・サーバーレスの基礎"
      },
      {
        "id": "basics-K12",
        "kind": "knowledge",
        "textJa": "料金の基本（従量課金、データ転送料金、購入オプションの概要）"
      },
      {
        "id": "basics-K13",
        "kind": "knowledge",
        "textJa": "主要サービスの全体像（Amazon EC2、Amazon S3、Amazon VPC、IAM、Amazon RDS、AWS Lambda など）"
      },
      {
        "id": "basics-K14",
        "kind": "knowledge",
        "textJa": "監視とログの基礎（Amazon CloudWatch、AWS CloudTrail、AWS Config）"
      }
    ]
