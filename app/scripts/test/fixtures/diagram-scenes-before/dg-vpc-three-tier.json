{"id":"dg-vpc-three-tier","type":"architecture","title":"3 層の VPC（2 つの AZ）","alt":"VPC の中に 2 つの AZ があり、それぞれにパブリック、プライベート、分離の 3 つのサブネットがあります。パブリックサブネットには ALB と NAT ゲートウェイ、プライベートサブネットにはアプリケーションのサーバー、分離されたサブネットにはデータベースがあります。利用者のリクエストはインターネットゲートウェイから ALB に入り、アプリケーション、データベースのプライマリへ進みます。ゾーン単位の NAT ゲートウェイを使う場合は、AZ ごとに置きます。この図はその構成で、アプリケーションから外へ出る通信は、同じ AZ の NAT ゲートウェイとインターネットゲートウェイを通ります。データベースは Multi-AZ DB インスタンス配置で、プライマリから別の AZ のスタンバイへ同期で複製します。","width":325,"height":419,"boxes":[{"id":"vpc","kind":"vpc","label":"VPC 10.0.0.0/16","x":2,"y":141,"w":321,"h":276,"depth":1,"parent":null,"tag":null},{"id":"az-a","kind":"az","label":"AZ-a","x":8,"y":156,"w":142,"h":255,"depth":2,"parent":"vpc","tag":null},{"id":"pub-a","kind":"subnet-public","label":"パブリック","x":14,"y":171,"w":130,"h":63,"depth":3,"parent":"az-a","tag":null},{"id":"pri-a","kind":"subnet-private","label":"プライベート","x":14,"y":259,"w":130,"h":63,"depth":3,"parent":"az-a","tag":null},{"id":"iso-a","kind":"subnet-isolated","label":"分離","x":14,"y":342,"w":130,"h":63,"depth":3,"parent":"az-a","tag":null},{"id":"az-c","kind":"az","label":"AZ-c","x":175,"y":156,"w":142,"h":255,"depth":2,"parent":"vpc","tag":null},{"id":"pub-c","kind":"subnet-public","label":"パブリック","x":181,"y":171,"w":130,"h":63,"depth":3,"parent":"az-c","tag":null},{"id":"pri-c","kind":"subnet-private","label":"プライベート","x":181,"y":259,"w":130,"h":63,"depth":3,"parent":"az-c","tag":null},{"id":"iso-c","kind":"subnet-isolated","label":"分離","x":181,"y":342,"w":130,"h":63,"depth":3,"parent":"az-c","tag":null}],"nodes":[{"id":"internet","kind":"internet","category":"other","short":null,"label":"インターネット","x":119,"y":2,"w":87,"h":42,"parent":null,"tag":null},{"id":"igw","kind":"igw","category":"network","short":"IGW","label":"出入り口","x":134.5,"y":64,"w":56,"h":42,"parent":null,"tag":null},{"id":"nat-a","kind":"nat-gateway","category":"network","short":"NAT","label":"外へ出る","x":20,"y":186,"w":56,"h":42,"parent":"pub-a","tag":null},{"id":"alb-a","kind":"elb","catego